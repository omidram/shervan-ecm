    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "three": "^0.180.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "unpdf": "^1.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
